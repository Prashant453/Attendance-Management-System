{
  "version": 2,
  "name": "attendify-student-attendance",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
